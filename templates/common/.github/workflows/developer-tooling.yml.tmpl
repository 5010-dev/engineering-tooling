name: Developer Tooling / Conformance

on:
  pull_request:
    branches:
      - dev
  push:
    branches:
      - dev
      - main
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: golden-path-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  conformance:
    uses: 5010-dev/engineering-tooling/.github/workflows/golden-path-quality.yml@[[.AutomationSourceCommit]]
    with:
      runner: ubuntu-24.04
      working-directory: .
      profiles: '[[.ProfilesJSON]]'
      checker-version: '[[.CheckerVersion]]'
      source-commit: '[[.AutomationSourceCommit]]'
      github-cli-version: '[[.GitHubCLIVersion]]'
      darwin-amd64-sha256: '[[.DarwinAMD64SHA256]]'
      darwin-arm64-sha256: '[[.DarwinARM64SHA256]]'
      linux-amd64-sha256: '[[.LinuxAMD64SHA256]]'
      linux-arm64-sha256: '[[.LinuxARM64SHA256]]'
