schemaVersion: golden-path-dependency-policy/v1
releaseUnits:
  path: .github/release-units.json
adapter: dependabot
defaults:
  owner:
    kind: codeowners
    reference: .github/CODEOWNERS
  releaseFlow:
    integrationBranch: dev
    releaseBranch: main
  canonicalGate:
    command:
      kind: just-recipe
      workingDirectory: .
      recipe: ci
    ciEvidence:
      - kind: github-actions-job
        workflow: .github/workflows/quality.yml
        job: quality
  routine: {}
  securityFallback:
    owner:
      kind: codeowners
      reference: .github/CODEOWNERS
    canonicalGate:
      command:
        kind: just-recipe
        workingDirectory: .
        recipe: ci
rootBindings: []
