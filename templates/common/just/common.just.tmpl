[private]
_common-init:
    mise install --locked
    ./scripts/golden-path --install-only

[private]
_common-check:
    #!/usr/bin/env sh
    set -eu
    git diff --check
    evaluated_at="${GOLDEN_PATH_EVALUATED_AT:-$(date -u +'%Y-%m-%dT%H:%M:%SZ')}"
    status=0
    ./scripts/golden-path check --root . --evaluated-at "$evaluated_at" --json-output - || status=$?
    if [ "$status" -eq 1 ]; then
      printf '%s\n' 'Golden Path 0.x is report-only; conformance violations remain visible above.' >&2
      exit 0
    fi
    exit "$status"

[private]
_common-ci:
    actionlint
