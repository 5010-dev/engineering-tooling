[private]
_common-init:
    mkdir -p .cache/golden-path/mise-config
    : > .cache/golden-path/mise-config/global.toml
    MISE_CONFIG_DIR="$PWD/.cache/golden-path/mise-config" MISE_GLOBAL_CONFIG_FILE="$PWD/.cache/golden-path/mise-config/global.toml" mise install --locked
    ./scripts/golden-path --install-only

[private]
_common-check:
    #!/usr/bin/env sh
    set -eu
    git diff --check
    git diff --cached --check
    evaluated_at="${GOLDEN_PATH_EVALUATED_AT:-$(date -u +'%Y-%m-%dT%H:%M:%SZ')}"
    result="${TMPDIR:-/tmp}/golden-path-result-$$.json"
    trap 'rm -f "$result"' EXIT HUP INT TERM
    status=0
    ./scripts/golden-path check --root . --evaluated-at "$evaluated_at" --json-output "$result" || status=$?
    if [ "$status" -eq 1 ]; then
      printf '%s\n' 'Golden Path conformance is report-only; violations remain visible above.' >&2
      exit 0
    fi
    exit "$status"

[private]
_common-ci:
    actionlint
