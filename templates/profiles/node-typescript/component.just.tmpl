[private]
_[[.RecipePrefix]]_init:
    cd [[.ShellPath]] && ./scripts/pnpm install --frozen-lockfile

[private]
_[[.RecipePrefix]]_format:
    cd [[.ShellPath]] && ./scripts/pnpm exec prettier --write .

[private]
_[[.RecipePrefix]]_format_check:
    cd [[.ShellPath]] && ./scripts/pnpm exec prettier --check .

[private]
_[[.RecipePrefix]]_lint:
    cd [[.ShellPath]] && ./scripts/pnpm exec eslint .

[private]
_[[.RecipePrefix]]_typecheck:
    cd [[.ShellPath]] && ./scripts/pnpm exec tsc --noEmit --pretty false

[private]
_[[.RecipePrefix]]_test:
    cd [[.ShellPath]] && ./scripts/pnpm exec vitest run

[private]
_[[.RecipePrefix]]_build:
    cd [[.ShellPath]] && rm -rf dist && ./scripts/pnpm exec tsc -p tsconfig.build.json

[private]
_[[.RecipePrefix]]_ci:
    cd [[.ShellPath]] && test -s dist/index.js
[[if .NodeExecutable]]    cd [[.ShellPath]] && test "$(node dist/index.js)" = [[.ProjectNameShellQuoted]]
[[end]]
