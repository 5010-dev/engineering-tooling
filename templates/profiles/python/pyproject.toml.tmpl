[build-system]
requires = ["uv_build==[[.UVBuildVersion]]"]
build-backend = "uv_build"

[project]
name = "[[.PackageName]]"
version = "0.1.0"
description = [[.StarterDescriptionQuoted]]
requires-python = ">=3.14,<3.15"
dependencies = []
[[if .PythonExecutable]]
[project.scripts]
[[.PackageName]] = "[[.PythonModule]]:main"
[[end]]

[dependency-groups]
dev = [
  "mypy==[[.MypyVersion]]",
  "pytest==[[.PytestVersion]]",
  "ruff==[[.RuffVersion]]",
  "uv-build==[[.UVBuildVersion]]",
]

[tool.uv]
package = true

[tool.uv.build-backend]
module-name = "[[.PythonModule]]"
module-root = "src"

[tool.ruff]
target-version = "py314"
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM"]

[tool.mypy]
python_version = "3.14"
strict = true
files = ["src", "tests"]

[tool.pytest.ini_options]
addopts = ["--strict-config", "--strict-markers"]
testpaths = ["tests"]
