[private]
_[[.RecipePrefix]]_init:
    cd [[.ShellPath]] && uv sync --locked --all-groups

[private]
_[[.RecipePrefix]]_format:
    cd [[.ShellPath]] && uv run --locked ruff format .

[private]
_[[.RecipePrefix]]_format_check:
    cd [[.ShellPath]] && uv run --locked ruff format --check .

[private]
_[[.RecipePrefix]]_lint:
    cd [[.ShellPath]] && uv run --locked ruff check .

[private]
_[[.RecipePrefix]]_typecheck:
    cd [[.ShellPath]] && uv run --locked mypy src tests

[private]
_[[.RecipePrefix]]_test:
    cd [[.ShellPath]] && uv run --locked pytest

[private]
_[[.RecipePrefix]]_build:
    cd [[.ShellPath]] && rm -rf dist && uv run --locked uv build --no-build-isolation --offline

[private]
_[[.RecipePrefix]]_check:
    cd [[.ShellPath]] && uv lock --check

[private]
_[[.RecipePrefix]]_ci:
    #!/usr/bin/env sh
    set -eu
    cd [[.ShellPath]]
    wheel="$(find dist -type f -name '*.whl' -print -quit)"
    test -n "$wheel"
    temporary="$(mktemp -d)"
    trap 'rm -rf "$temporary"' EXIT HUP INT TERM
    uv venv --python [[.PythonVersion]] "$temporary/venv"
    uv pip install --python "$temporary/venv/bin/python" --no-deps "$wheel"
    "$temporary/venv/bin/python" -c 'import [[.PythonModule]]'
[[if .PythonExecutable]]    test "$($temporary/venv/bin/[[.PackageName]])" = [[.ProjectNameJustShellQuoted]]
[[end]]
