[private]
_[[.RecipePrefix]]_init:
    #!/usr/bin/env sh
    set -eu
    cd [[.ShellPath]]
    zig version | grep -Fx '[[.ZigVersion]]'
    ./scripts/zig-target >/dev/null
    mkdir -p .cache/zig-global

[private]
_[[.RecipePrefix]]_typecheck:
    #!/usr/bin/env sh
    set -eu
    cd [[.ShellPath]]
    target="$(./scripts/zig-target)"
    output="$(mktemp -d)"
    trap 'rm -rf "$output"' EXIT HUP INT TERM
    ZIG_GLOBAL_CACHE_DIR="$PWD/.cache/zig-global" zig cc -target "$target" -std=c17 -Wall -Wextra -Werror -c src/main.c -o "$output/main.o"
    test -s "$output/main.o"

[private]
_[[.RecipePrefix]]_test:
    #!/usr/bin/env sh
    set -eu
    cd [[.ShellPath]]
    target="$(./scripts/zig-target)"
    output="$(mktemp -d)"
    trap 'rm -rf "$output"' EXIT HUP INT TERM
    ZIG_GLOBAL_CACHE_DIR="$PWD/.cache/zig-global" zig cc -target "$target" -std=c17 -Wall -Wextra -Werror src/main.c -o "$output/[[.PackageName]]"
    "$output/[[.PackageName]]"

[private]
_[[.RecipePrefix]]_build:
    #!/usr/bin/env sh
    set -eu
    cd [[.ShellPath]]
    target="$(./scripts/zig-target)"
    mkdir -p zig-out/bin
    ZIG_GLOBAL_CACHE_DIR="$PWD/.cache/zig-global" zig cc -target "$target" -std=c17 -Wall -Wextra -Werror src/main.c -o zig-out/bin/[[.PackageName]]

[private]
_[[.RecipePrefix]]_ci:
    cd [[.ShellPath]] && test -x zig-out/bin/[[.PackageName]]
