{
  "schemaVersion": "golden-path-zig-toolchain/v1",
  "compiler": "zig cc [[.ZigVersion]]",
  "languageStandard": "c17",
  "flags": ["-Wall", "-Wextra", "-Werror"],
  "headers": [],
  "targets": [
    { "host": "darwin/amd64", "target": "x86_64-macos", "libc": "system", "execution": true },
    { "host": "darwin/arm64", "target": "aarch64-macos", "libc": "system", "execution": true },
    { "host": "linux/amd64", "target": "x86_64-linux-musl", "libc": "musl", "execution": true },
    { "host": "linux/arm64", "target": "aarch64-linux-musl", "libc": "musl", "execution": true }
  ],
  "artifact": "zig-out/bin/[[.PackageName]]",
  "artifactSmoke": "native execution on the matching declared host"
}
