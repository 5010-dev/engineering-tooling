//! [[.ProjectName]] library.

/// Returns the project identity.
#[must_use]
pub const fn project_name() -> &'static str {
    "[[.ProjectName]]"
}

#[cfg(test)]
mod tests {
    use super::project_name;

    #[test]
    fn exposes_the_project_identity() {
        assert_eq!(project_name(), "[[.ProjectName]]");
    }
}
