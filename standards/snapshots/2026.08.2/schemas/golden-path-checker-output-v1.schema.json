{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:schema:checker-output:v1",
  "title": "Golden Path checker output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "standardVersion",
    "checkerVersion",
    "catalogDigest",
    "evaluatedAt",
    "enforcement",
    "profiles",
    "exitCode",
    "complete",
    "summary",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "golden-path-checker-output/v1"
    },
    "contractVersion": {
      "const": "golden-path/v1"
    },
    "standardVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])(?:\\.[1-9][0-9]*)?$"
    },
    "checkerVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "catalogDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "enforcement": {
      "enum": [
        "report-only",
        "policy-required",
        "platform-enforced"
      ]
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exitCode": {
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "warn",
        "skip",
        "waived",
        "error"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "skip": {
          "type": "integer",
          "minimum": 0
        },
        "waived": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "status",
        "severity",
        "assessment",
        "path",
        "message",
        "remediation",
        "exceptionId"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^DT-[A-Z]+-[0-9]{3}$"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "skip",
            "waived",
            "error"
          ]
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "assessment": {
          "enum": [
            "automated",
            "manual",
            "hybrid"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+)$"
        },
        "secondaryKey": {
          "type": "string",
          "maxLength": 500
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "exceptionId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^GPE-[0-9]{4}-[0-9]{3,}$"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "waived"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exceptionId": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
