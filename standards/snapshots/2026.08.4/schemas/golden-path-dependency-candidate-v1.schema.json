{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:golden-path-dependency-candidate:v1",
  "title": "Golden Path dependency adoption candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "policySHA256", "changes", "roots", "queueActions", "conflictCount"],
  "properties": {
    "schemaVersion": {"const": "golden-path-dependency-candidate/v1"},
    "repository": {"type": "string", "minLength": 1},
    "policySHA256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "ownership", "status"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "ownership": {"type": "string", "enum": ["managed", "repository-owned"]},
          "status": {"type": "string", "enum": ["create", "update", "preserve", "conflict"]},
          "desiredSHA256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "currentSHA256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nativeRootRef", "status"],
        "properties": {
          "nativeRootRef": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["classified", "pending-classification"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "queueActions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pullRequest", "action", "reason"],
        "properties": {
          "pullRequest": {"type": "string", "minLength": 1},
          "action": {"type": "string", "enum": ["preserve-security", "preserve-manual", "close-obsolete", "regroup-routine", "pending-classification"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "conflictCount": {"type": "integer", "minimum": 0}
  }
}
