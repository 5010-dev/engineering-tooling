{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:schema:metadata:v1",
  "title": "Golden Path repository metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "standardVersion",
    "assetBundleVersion",
    "profiles",
    "artifactTypes",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "golden-path-metadata/v1"
    },
    "contractVersion": {
      "const": "golden-path/v1"
    },
    "standardVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])(?:\\.[1-9][0-9]*)?$"
    },
    "assetBundleVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "applicability": {
      "$ref": "#/$defs/applicability"
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "artifactTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactType"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "applicability": {
            "properties": {
              "status": {
                "const": "not-applicable"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "applicability"
        ]
      },
      "then": {
        "properties": {
          "applicability": {
            "required": [
              "reason"
            ]
          },
          "profiles": {
            "maxItems": 0
          },
          "artifactTypes": {
            "maxItems": 0
          },
          "capabilities": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "profiles": {
            "minItems": 1
          },
          "artifactTypes": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "applicable",
            "not-applicable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 12,
          "maxLength": 500
        }
      }
    },
    "profile": {
      "enum": [
        "node-typescript",
        "python",
        "go",
        "rust",
        "zig",
        "zig-toolchain",
        "infrastructure-aws-cdk",
        "infrastructure-terraform",
        "infrastructure-opentofu",
        "infrastructure-pulumi",
        "documentation"
      ]
    },
    "artifactType": {
      "enum": [
        "application",
        "service",
        "library",
        "cli",
        "package",
        "binary",
        "container",
        "infrastructure",
        "tooling",
        "documentation"
      ]
    },
    "capability": {
      "enum": [
        "format",
        "lint",
        "typecheck",
        "test",
        "build",
        "package",
        "publish",
        "coverage",
        "fuzz",
        "unsafe",
        "native-extension",
        "cgo",
        "released-artifact",
        "dependency-automation",
        "cache",
        "devcontainer"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "tier"
      ],
      "properties": {
        "os": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "architecture": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "targetTriple": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "primary",
            "secondary",
            "evaluation"
          ]
        },
        "execution": {
          "type": "boolean"
        }
      }
    }
  }
}
