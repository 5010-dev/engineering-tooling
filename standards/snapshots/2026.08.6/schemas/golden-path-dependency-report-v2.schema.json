{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:golden-path-dependency-report:v2",
  "title": "Golden Path organization dependency report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "observedAt", "observationIdentity", "scope", "repositories", "securityAdvisories"],
  "properties": {
    "schemaVersion": {"const": "golden-path-dependency-report/v2"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "observedAt": {"type": "string", "format": "date-time"},
    "observationIdentity": {"type": "string", "pattern": "^urn:sha256:[a-f0-9]{64}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "query"],
      "properties": {
        "organization": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1}
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "defaultBranchSHA", "applicability", "classifiedRoots", "pendingRoots", "routineOpen", "securityOpen", "openAlerts", "openAdvisoryGroups", "partialSecurityAdvisories", "ownerRoutingCoverage"],
        "properties": {
          "repository": {"type": "string", "minLength": 1},
          "defaultBranchSHA": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "applicability": {"type": "string", "enum": ["applicable", "not-applicable", "unknown"]},
          "classifiedRoots": {"type": "integer", "minimum": 0},
          "pendingRoots": {"type": "integer", "minimum": 0},
          "routineOpen": {"type": "integer", "minimum": 0},
          "securityOpen": {"type": "integer", "minimum": 0},
          "openAlerts": {"type": "integer", "minimum": 0},
          "openAdvisoryGroups": {"type": "integer", "minimum": 0},
          "partialSecurityAdvisories": {"type": "integer", "minimum": 0},
          "ownerRoutingCoverage": {"type": "number", "minimum": 0},
          "oldestRoutineObservedAt": {"type": "string", "format": "date-time"},
          "deferred": {"type": "integer", "minimum": 0},
          "stale": {"type": "boolean"}
        }
      }
    },
    "securityAdvisories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "advisoryIdentity", "dependency", "remediationCoverage", "openAlertInstances"],
        "properties": {
          "repository": {"type": "string", "minLength": 1},
          "advisoryIdentity": {"type": "string", "minLength": 1},
          "dependency": {"type": "string", "minLength": 1},
          "remediationCoverage": {"type": "string", "enum": ["none", "partial", "all-linked"]},
          "openAlertInstances": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["number", "severity", "relationship"],
              "properties": {
                "number": {"type": "integer", "minimum": 1},
                "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
                "relationship": {"type": "string", "enum": ["direct", "transitive"]},
                "manifestPath": {"type": "string", "minLength": 1},
                "fixedIn": {"type": "string", "minLength": 1},
                "securityUpdatePullRequest": {"type": "string", "format": "uri"}
              }
            }
          }
        }
      }
    }
  }
}
