{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:golden-path-dependency-observation:v2",
  "title": "Golden Path live dependency observation with dependency relationship evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observedAt", "scope", "source", "repositories", "pullRequests", "alerts"],
  "properties": {
    "schemaVersion": {"const": "golden-path-dependency-observation/v2"},
    "observedAt": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "query"],
      "properties": {
        "organization": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "repositories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "apiVersion", "identity", "sha256"],
      "properties": {
        "kind": {"const": "github-dependabot-api"},
        "apiVersion": {"const": "2022-11-28"},
        "identity": {"type": "string", "pattern": "^urn:sha256:[a-f0-9]{64}$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "repositoryNodeId", "defaultBranch", "defaultBranchSHA"],
        "properties": {
          "repository": {"type": "string", "minLength": 1},
          "repositoryNodeId": {"type": "string", "minLength": 1},
          "defaultBranch": {"type": "string", "minLength": 1},
          "defaultBranchSHA": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "dependencyPolicySHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "nativeRootsSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "releaseUnitsSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "defersSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "pullRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "repositoryNodeId", "number", "nodeId", "url", "base", "head", "classification", "state", "createdAt", "updatedAt", "checkRollup"],
        "properties": {
          "repository": {"type": "string", "minLength": 1},
          "repositoryNodeId": {"type": "string", "minLength": 1},
          "number": {"type": "integer", "minimum": 1},
          "nodeId": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "base": {"$ref": "#/$defs/refIdentity"},
          "head": {"$ref": "#/$defs/refIdentity"},
          "classification": {"type": "string", "enum": ["routine", "security-update", "security-remediation", "unknown"]},
          "state": {"type": "string", "enum": ["open", "closed"]},
          "createdAt": {"type": "string", "format": "date-time"},
          "updatedAt": {"type": "string", "format": "date-time"},
          "checkRollup": {"$ref": "#/$defs/checkRollup"},
          "securityClosureEvidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/securityClosureEvidence"}
          },
          "nativeRootRef": {"type": "string", "minLength": 1},
          "ownerRoute": {"type": "string", "minLength": 1}
        }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "number", "advisoryIdentity", "state", "severity", "ecosystem", "dependency", "relationship"],
        "properties": {
          "repository": {"type": "string", "minLength": 1},
          "number": {"type": "integer", "minimum": 1},
          "advisoryIdentity": {"type": "string", "minLength": 1},
          "state": {"type": "string", "enum": ["open", "dismissed", "auto-dismissed", "fixed"]},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "ecosystem": {"type": "string", "minLength": 1},
          "dependency": {"type": "string", "minLength": 1},
          "relationship": {"type": "string", "enum": ["direct", "transitive", "unknown"]},
          "manifestPath": {"type": "string", "minLength": 1},
          "fixedIn": {"type": "string", "minLength": 1},
          "securityUpdatePullRequest": {"type": "string", "format": "uri"}
        }
      }
    },
    "nativeManagerObservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "nativeRootRef", "sourceURI", "sourceVersion", "observedAt", "sha256"],
        "properties": {
          "repository": {"type": "string", "minLength": 1},
          "nativeRootRef": {"type": "string", "minLength": 1},
          "sourceURI": {"type": "string", "format": "uri"},
          "sourceVersion": {"type": "string", "minLength": 1},
          "observedAt": {"type": "string", "format": "date-time"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "refIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "securityClosureEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workflow", "job", "runId", "runUrl", "headSHA", "status", "conclusion", "observedAt"],
      "properties": {
        "kind": {"const": "github-actions-job-run"},
        "workflow": {"type": "string", "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$"},
        "job": {"type": "string", "minLength": 1},
        "runId": {"type": "integer", "minimum": 1},
        "runAttempt": {"type": "integer", "minimum": 1},
        "runUrl": {"type": "string", "format": "uri"},
        "headSHA": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "status": {"type": "string", "enum": ["queued", "in-progress", "completed"]},
        "conclusion": {"type": "string", "enum": ["success", "failure", "cancelled", "skipped", "neutral", "timed-out", "action-required", "stale", "none"]},
        "observedAt": {"type": "string", "format": "date-time"}
      }
    },
    "checkRollup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "conclusion"],
      "properties": {
        "status": {"type": "string", "enum": ["queued", "in-progress", "completed", "none"]},
        "conclusion": {"type": "string", "enum": ["success", "failure", "cancelled", "skipped", "neutral", "timed-out", "action-required", "stale", "none"]}
      }
    }
  }
}
