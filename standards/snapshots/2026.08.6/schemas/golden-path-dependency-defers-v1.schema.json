{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:golden-path-dependency-defers:v1",
  "title": "Golden Path dependency defers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defers"],
  "properties": {
    "schemaVersion": {"const": "golden-path-dependency-defers/v1"},
    "defers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ecosystem", "nativeRootRef", "dependency", "versionRange", "currentVersion", "availableVersion", "riskClass", "reason", "owner", "observedAt", "reviewedAt", "reviewAfter"],
        "properties": {
          "ecosystem": {"type": "string", "minLength": 1},
          "nativeRootRef": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "dependency": {"type": "string", "minLength": 1},
          "versionRange": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "availableVersion": {"type": "string", "minLength": 1},
          "riskClass": {"type": "string", "enum": ["major", "pre-1.0-minor", "other-manual"]},
          "reason": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "observedAt": {"type": "string", "format": "date-time"},
          "reviewedAt": {"type": "string", "format": "date"},
          "reviewAfter": {"type": "string", "format": "date"},
          "source": {"type": "string", "format": "uri"},
          "workLink": {"type": "string", "format": "uri"}
        }
      }
    }
  }
}
