{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:schema:exceptions:v1",
  "title": "Golden Path exceptions v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exceptions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "golden-path-exceptions/v1"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "$defs": {
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rules",
        "scope",
        "reason",
        "owner",
        "riskClass",
        "approval",
        "expiresAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GPE-[0-9]{4}-[0-9]{3,}$"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DT-[A-Z]+-[0-9]{3}$"
          }
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "reason": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "owner": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "riskClass": {
          "enum": [
            "standard",
            "high"
          ]
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "expiresAt": {
          "type": "string",
          "format": "date"
        },
        "trackingIssue": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "risk": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "compensatingControls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          }
        },
        "renewedFrom": {
          "type": "string",
          "pattern": "^GPE-[0-9]{4}-[0-9]{3,}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "riskClass": {
                "const": "high"
              }
            },
            "required": [
              "riskClass"
            ]
          },
          "then": {
            "required": [
              "trackingIssue",
              "risk",
              "compensatingControls"
            ],
            "properties": {
              "approval": {
                "properties": {
                  "authorities": {
                    "minItems": 2
                  }
                }
              }
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifactTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "profiles"
          ]
        },
        {
          "required": [
            "artifactTypes"
          ]
        },
        {
          "required": [
            "capabilities"
          ]
        },
        {
          "required": [
            "paths"
          ]
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorities"
      ],
      "properties": {
        "authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "reference",
              "approvedAt"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 2,
                "maxLength": 200
              },
              "reference": {
                "type": "string",
                "minLength": 2,
                "maxLength": 500
              },
              "approvedAt": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    }
  }
}
