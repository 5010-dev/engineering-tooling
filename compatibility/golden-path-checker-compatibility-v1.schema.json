{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:schema:checker-compatibility:v1",
  "title": "Golden Path checker compatibility manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkerVersion",
    "lifecycle",
    "enforcement",
    "standards",
    "supportedTargets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "golden-path-checker-compatibility/v1"
    },
    "checkerVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "lifecycle": {
      "enum": [
        "prerelease",
        "stable",
        "deprecated",
        "eol"
      ]
    },
    "enforcement": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "report-only",
          "policy-required",
          "platform-enforced"
        ]
      }
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "standardVersion",
          "contractVersion",
          "schemaVersions",
          "snapshot",
          "sourceCommit",
          "catalogDigest"
        ],
        "properties": {
          "standardVersion": {
            "type": "string",
            "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])(?:\\.[1-9][0-9]*)?$"
          },
          "contractVersion": {
            "type": "string",
            "pattern": "^golden-path/v[1-9][0-9]*$"
          },
          "schemaVersions": {
            "type": "array",
            "minItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "snapshot": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "sourceCommit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "catalogDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "supportedTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "os",
          "architecture"
        ],
        "properties": {
          "os": {
            "enum": [
              "darwin",
              "linux"
            ]
          },
          "architecture": {
            "enum": [
              "amd64",
              "arm64"
            ]
          }
        }
      }
    }
  }
}
