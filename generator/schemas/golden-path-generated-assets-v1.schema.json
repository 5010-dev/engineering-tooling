{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:schema:generated-assets:v1",
  "title": "Golden Path generated asset inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "standardVersion", "assetBundleVersion", "releaseVersion", "source", "requestSHA256", "files"],
  "properties": {
    "schemaVersion": { "const": "golden-path-generated-assets/v1" },
    "standardVersion": { "type": "string", "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])(?:\\.[1-9][0-9]*)?$" },
    "assetBundleVersion": { "$ref": "#/$defs/semver" },
    "releaseVersion": { "$ref": "#/$defs/semver" },
    "source": { "$ref": "#/$defs/source" },
    "requestSHA256": { "$ref": "#/$defs/digest", "description": "SHA-256 of the compact canonical JSON encoding of the normalized generator request, not the source YAML or pretty-printed request bytes." },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "sha256", "source"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["0644", "0755"] },
          "sha256": { "$ref": "#/$defs/digest" },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tag"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
      }
    }
  }
}
