{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:schema:generator-request:v1",
  "title": "Golden Path generator request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "layout", "projectName", "projectSlug", "components"],
  "properties": {
    "schemaVersion": { "const": "golden-path-generator-request/v1" },
    "layout": { "enum": ["single", "monorepo", "polyglot", "documentation"] },
    "projectName": { "type": "string", "minLength": 2, "maxLength": 100 },
    "projectSlug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "profiles", "artifactTypes"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "path": { "type": "string", "minLength": 1 },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "documentation", "go", "node-typescript", "python", "rust", "zig", "zig-toolchain",
                "infrastructure-aws-cdk", "infrastructure-terraform", "infrastructure-opentofu", "infrastructure-pulumi"
              ]
            }
          },
          "artifactTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["application", "service", "library", "cli", "package", "binary", "container", "infrastructure", "tooling", "documentation"]
            }
          },
          "modulePath": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
