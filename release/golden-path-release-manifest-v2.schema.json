{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:schema:release-manifest:v2",
  "title": "Golden Path release manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseVersion",
    "lifecycle",
    "enforcement",
    "standardVersion",
    "contractVersion",
    "schemaVersions",
    "source",
    "catalogDigest",
    "snapshotAggregateDigest",
    "compatibility",
    "standardSnapshot",
    "schemas",
    "releaseNotes",
    "toolingCutoff",
    "runtimeSelections",
    "components",
    "assets",
    "build",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "golden-path-release-manifest/v2" },
    "releaseVersion": { "$ref": "#/$defs/semver" },
    "lifecycle": { "enum": ["stable", "deprecated", "eol"] },
    "enforcement": { "$ref": "#/$defs/enforcement" },
    "standardVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])(?:\\.[1-9][0-9]*)?$"
    },
    "contractVersion": { "type": "string", "pattern": "^golden-path/v[1-9][0-9]*$" },
    "schemaVersions": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tag"],
      "properties": {
        "repository": { "const": "https://github.com/5010-dev/engineering-tooling" },
        "commit": { "$ref": "#/$defs/sha" },
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "catalogDigest": { "$ref": "#/$defs/prefixedDigest" },
    "snapshotAggregateDigest": { "$ref": "#/$defs/prefixedDigest" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "supportedStandards"],
      "properties": {
        "file": {
          "allOf": [
            { "$ref": "#/$defs/fileEvidence" },
            { "properties": { "name": { "const": "compatibility-manifest.json" } } }
          ]
        },
        "supportedStandards": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/supportedStandard" }
        }
      }
    },
    "standardSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "source", "aggregateDigest"],
      "properties": {
        "file": {
          "allOf": [
            { "$ref": "#/$defs/fileEvidence" },
            { "properties": { "name": { "const": "standard-snapshot-manifest.json" } } }
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "path", "gitTree"],
          "properties": {
            "repository": { "const": "https://github.com/5010-dev/.github" },
            "commit": { "$ref": "#/$defs/sha" },
            "path": { "const": "docs/standards/developer-tooling" },
            "gitTree": { "$ref": "#/$defs/sha" }
          }
        },
        "aggregateDigest": { "$ref": "#/$defs/prefixedDigest" }
      }
    },
    "schemas": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+(?:/[a-z0-9-]+)*/v[1-9][0-9]*$" },
          "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.schema\\.json$" },
          "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "releaseNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "provides"],
      "properties": {
        "file": {
          "allOf": [
            { "$ref": "#/$defs/fileEvidence" },
            { "properties": { "name": { "const": "RELEASE_NOTES.md" } } }
          ]
        },
        "provides": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["changelog", "migration", "rollback"] },
          "allOf": [
            { "contains": { "const": "changelog" } },
            { "contains": { "const": "migration" } },
            { "contains": { "const": "rollback" } }
          ]
        }
      }
    },
    "toolingCutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "schema", "checkedAt", "sha256"],
      "properties": {
        "manifest": { "const": "tooling-cutoff.json" },
        "schema": { "const": "golden-path-tooling-cutoff-v1.schema.json" },
        "checkedAt": { "type": "string", "format": "date-time" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "runtimeSelections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "tool", "versions"],
        "properties": {
          "profile": { "enum": ["node-typescript", "python", "go", "rust", "zig", "zig-toolchain"] },
          "tool": { "enum": ["node", "python", "go", "rust", "zig"] },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "disposition"],
              "properties": {
                "version": { "$ref": "#/$defs/exactVersion" },
                "disposition": { "enum": ["preferred", "supported", "compatibility-only", "blocked"] },
                "supportEndsAt": { "type": "string", "format": "date" }
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checker", "generator", "assetBundle", "automation"],
      "properties": {
        "checker": { "$ref": "#/$defs/executableComponent" },
        "generator": { "$ref": "#/$defs/executableComponent" },
        "assetBundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "digest", "requestSchema", "generatedAssetsSchema", "planSchema"],
          "properties": {
            "version": { "$ref": "#/$defs/semver" },
            "digest": { "$ref": "#/$defs/prefixedDigest" },
            "requestSchema": { "const": "golden-path-generator-request/v1" },
            "generatedAssetsSchema": { "const": "golden-path-generated-assets/v1" },
            "planSchema": { "const": "golden-path-materialization-plan/v1" }
          }
        },
        "automation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "digest", "reusableWorkflow", "setupAction"],
          "properties": {
            "version": { "$ref": "#/$defs/semver" },
            "digest": { "$ref": "#/$defs/prefixedDigest" },
            "reusableWorkflow": { "const": ".github/workflows/golden-path-quality.yml" },
            "setupAction": { "const": "actions/setup-golden-path/action.yml" }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "os", "architecture", "sha256", "executableSHA256", "size", "sbom"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^golden-path_[0-9]+\\.[0-9]+\\.[0-9]+_(darwin|linux)_(amd64|arm64)\\.tar\\.gz$"
          },
          "os": { "enum": ["darwin", "linux"] },
          "architecture": { "enum": ["amd64", "arm64"] },
          "sha256": { "$ref": "#/$defs/digest" },
          "executableSHA256": { "$ref": "#/$defs/digest" },
          "size": { "type": "integer", "minimum": 1 },
          "sbom": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "format", "specVersion", "sha256", "size"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^golden-path_[0-9]+\\.[0-9]+\\.[0-9]+_(darwin|linux)_(amd64|arm64)\\.cdx\\.json$"
              },
              "format": { "const": "CycloneDX" },
              "specVersion": { "const": "1.6" },
              "sha256": { "$ref": "#/$defs/digest" },
              "size": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolchain", "cleanCheckout", "validationWorkflow", "commands"],
      "properties": {
        "toolchain": { "type": "string", "pattern": "^go[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "cleanCheckout": { "const": true },
        "validationWorkflow": { "const": ".github/workflows/release.yml" },
        "commands": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 3 } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "workflow", "subject"],
      "properties": {
        "provider": { "type": "string", "minLength": 3 },
        "workflow": { "const": ".github/workflows/release.yml" },
        "subject": { "type": "string", "minLength": 3 }
      }
    }
  },
  "$defs": {
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "supportedStandard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standardVersion",
        "contractVersion",
        "schemaVersions",
        "snapshot",
        "sourceCommit",
        "catalogDigest",
        "snapshotAggregateDigest"
      ],
      "properties": {
        "standardVersion": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])(?:\\.[1-9][0-9]*)?$"
        },
        "contractVersion": { "type": "string", "pattern": "^golden-path/v[1-9][0-9]*$" },
        "schemaVersions": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "snapshot": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
        "sourceCommit": { "$ref": "#/$defs/sha" },
        "catalogDigest": { "$ref": "#/$defs/prefixedDigest" },
        "snapshotAggregateDigest": { "$ref": "#/$defs/prefixedDigest" }
      }
    },
    "executableComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "executable", "digest", "lifecycle", "enforcement"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "executable": { "const": "golden-path" },
        "digest": { "$ref": "#/$defs/prefixedDigest" },
        "lifecycle": { "enum": ["stable", "deprecated", "eol"] },
        "enforcement": { "$ref": "#/$defs/enforcement" }
      }
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "exactVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "prefixedDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "enforcement": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["report-only", "policy-required", "platform-enforced"] }
    }
  }
}
