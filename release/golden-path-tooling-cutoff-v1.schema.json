{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:schema:tooling-cutoff:v1",
  "title": "Golden Path external tooling cutoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkedAt",
    "standardVersion",
    "releaseVersion",
    "miseMinimumVersion",
    "integrityRecords",
    "toolSelections",
    "runtimeSupport",
    "workflowActions"
  ],
  "properties": {
    "schemaVersion": { "const": "golden-path-tooling-cutoff/v1" },
    "checkedAt": { "type": "string", "format": "date-time" },
    "standardVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])(?:\\.[1-9][0-9]*)?$"
    },
    "releaseVersion": { "$ref": "#/$defs/semver" },
    "miseMinimumVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]+\\.[0-9]+$"
    },
    "integrityRecords": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/integrityRecord" }
    },
    "toolSelections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/toolSelection" }
    },
    "runtimeSupport": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/runtimeSupport" }
    },
    "workflowActions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workflowAction" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "exactVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "integrityRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "toolSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "supportStatus",
        "officialSource",
        "integrityAuthority",
        "integrityEvidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "version": { "$ref": "#/$defs/exactVersion" },
        "supportStatus": {
          "enum": ["preferred", "supported", "compatibility-pinned"]
        },
        "officialSource": { "type": "string", "format": "uri", "pattern": "^https://" },
        "integrityAuthority": {
          "enum": [
            "mise-lock",
            "pnpm-lock",
            "uv-lock",
            "go-sum",
            "native-manager",
            "release-checksum"
          ]
        },
        "integrityEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
        },
        "latestObservedVersion": { "$ref": "#/$defs/exactVersion" },
        "selectionReason": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "tool", "version", "disposition", "officialSource"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/exactVersion" },
        "disposition": {
          "enum": ["preferred", "supported", "compatibility-only", "blocked"]
        },
        "supportEndsAt": { "type": "string", "format": "date" },
        "officialSource": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "workflowAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "commit", "officialSource"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "officialSource": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    }
  }
}
