{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5010-dev:golden-path:schema:source-integrity:v1",
  "title": "Golden Path release source integrity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkedAt",
    "standardVersion",
    "releaseVersion",
    "integrityRecords"
  ],
  "properties": {
    "schemaVersion": { "const": "golden-path-source-integrity/v1" },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "standardVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])(?:\\.[1-9][0-9]*)?$"
    },
    "releaseVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "integrityRecords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "enum": [
              "go.sum",
              "mise.lock",
              "templates/bundle.json",
              "templates/profiles/go/go.sum.tmpl",
              "templates/profiles/node-typescript/pnpm-lock.base.yaml.tmpl",
              "templates/profiles/node-typescript/pnpm-lock.cdk.yaml.tmpl",
              "templates/profiles/node-typescript/pnpm-lock.pulumi.yaml.tmpl",
              "templates/profiles/python/.python-version.tmpl",
              "templates/profiles/python/uv.lock.tmpl",
              "templates/profiles/rust/rust-toolchain.toml.tmpl",
              "templates/tooling/mise.lock"
            ]
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
